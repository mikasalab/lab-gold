# Salin menjadi .env untuk uji di komputer sendiri. Di GitHub, isi lewat Settings > Secrets and variables > Actions.
# JANGAN commit file .env (sudah ada di .gitignore).

# --- Data harga ---
TWELVE_DATA_KEY=

# --- AI ---
GEMINI_API_KEY=
GROQ_API_KEY=

# --- Telegram (bot sinyal dan bot alert terpisah) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_BOT_TOKEN=
ALERT_CHAT_ID=

# --- Database (MongoDB Atlas) ---
MONGO_URL=
DB_NAME=xauv3

# --- Opsional ---
GH_TOKEN_EXPIRY=2027-10-25
# PROMPT_TEXT=            (isi bila prompt ingin dirahasiakan dari repo publik)
# MIN_CONFIDENCE=6
# MAX_SIGNALS_DAY=3
# SEND_RESULTS=0          (1 = kirim pesan hasil TP/SL ke bot sinyal)

# --- Nama model (simpan di Variables GitHub, bukan Secrets; ganti bila model lama dimatikan) ---
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
# GROQ_MODEL=qwen/qwen3.8-27b
# GEMINI_THINKING=low     (minimal|low|medium|high|off)
